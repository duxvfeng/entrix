{
  "description": "Entrix Stop Gate：在 Claude 请求结束任务时独立收集证据并裁决是否放行（仅在配置了 docs/fitness 的仓库激活）",
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-gate.sh\"",
            "timeout": 295
          }
        ]
      }
    ]
  }
}
