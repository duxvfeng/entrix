#!/bin/bash
# Entrix CLI launcher script
# This script finds and executes the entrix Python module

# Try to use installed entrix command first
if command -v entrix &> /dev/null; then
    exec entrix "$@"
fi

# Fallback to python -m entrix
if command -v python &> /dev/null; then
    exec python -m entrix "$@"
elif command -v python3 &> /dev/null; then
    exec python3 -m entrix "$@"
else
    echo "Error: Neither 'entrix' command nor Python found" >&2
    echo "Please install entrix: pip install entrix" >&2
    exit 1
fi